void ComputationBase:: scandata() 
{
   double invalue;
   for (int i=0; i<Num; i++) {
      std::cout << "Entrez un nombre flottant" << endl;
      std::cin >> invalue;
      data_y.push_back(invalue);
   }
}

int ComputationBase:: predict(int k) {
   double sum=0.;
   // do the mean instead or AR(n), temporary
   for (int i=0; i<k; i++) {
      sum += data_y[i]; 
   }
   curr_yest = sum/k;
   return 0;
}

