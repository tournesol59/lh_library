#include "decl_Computation.hpp"

ComputationBase:: ComputationBase(std::vector<double> fcoeff, int dn, int dNum) :
   data_y(std::vector<double>(dNum, 0.0)),
   pred_y(std::vector<double>(dNum, 0.0)),
   n(dn),
   Num(Num)
{
   for (int i=0; i<n; i++) {
      coeff.push_back(fcoeff[i]);
   }
   gaink.push_back(1.0);
}
// copy constructors
ComputationBase:: ComputationBase(const ComputationBase &src) :
   data_y(src.data_y),
   pred_y(src.pred_y)//,
 //  n(src.n),
 //  Num(src.Num)
{
   n=src.n;
   Num=src.Num;
   for (int i=0; i<src.n; i++) {
      coeff.push_back(src.coeff[i]);
   }
   gaink.push_back(src.gaink[0]);
}

