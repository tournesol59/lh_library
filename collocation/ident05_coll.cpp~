   // 
   // Number Cstlam = lambda*lambda/(omx*omx+lambda*lambda)
   // Number Cstmu = mu*mu/(omx*omx+mu*mu)  // only if mu is nnz

   // exact[i] =0.
   // exact[i] += Civp[0]*intermsolarray[i][0]*intermsolarray[1]; // cos
